# eHANAP (Roxas, Oriental Mindoro PESO) - Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.

# Supabase Project URL (e.g. https://your-project.supabase.co or http://127.0.0.1:54321 for local development)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Google AI Gemini API Key (for resume ATS keyword extraction and job analysis)
GEMINI_API_KEY=
